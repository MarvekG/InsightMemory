  {
    "case_id": "alias_after_correction_not_old_name",
    "category": "realworld_adversarial_alias",
    "description": "别名和更正同时出现时，简称查询应落到更正后的当前事实，而不是旧名称或邻近公告。",
    "memory_scope_templates": {
      "primary": "eval:generic_realworld_adversarial_v1:{run_id}:{case_id}"
    },
    "writes": [
      {
        "context": "North Pier intake binder（简称 NPI）初版写成需要 blue receipt。",
        "expected_status": "accepted"
      },
      {
        "context": "NPI binder 更正：当前实际缺少的是 signed dock waiver，不是 blue receipt。",
        "expected_status": "accepted"
      },
      {
        "context": "North Pier incident bulletin 今天只更新了 visitor badge color。",
        "expected_status": "accepted"
      }
    ],
    "queries": [
      {
        "query_id": "q1",
        "query": "NPI binder 当前实际缺少什么？",
        "expected_status": "ok",
        "citations_min": 1,
        "non_empty_answer": true,
        "judge_required_facts": [
          "signed dock waiver"
        ],
        "judge_forbidden_facts": [
          "blue receipt",
          "visitor badge color"
        ]
      },
      {
        "query_id": "q2",
        "query": "North Pier incident bulletin 今天更新了什么？",
        "expected_status": "ok",
        "citations_min": 1,
        "non_empty_answer": true,
        "judge_required_facts": [
          "visitor badge color"
        ],
        "judge_forbidden_facts": [
          "signed dock waiver",
          "blue receipt"
        ]
      }
    ],
    "expected": {
      "primary": {
        "observation_count": 3,
        "recall_audit_count": 2,
        "required_memory_texts": [
          "signed dock waiver",
          "visitor badge color"
        ]
      }
    }
  },
