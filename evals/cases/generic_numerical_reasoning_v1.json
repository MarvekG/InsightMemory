      {
        "query_id": "q2",
        "query": "数据中心室温达到多少度才会触发环境告警？",
        "expected_status": "ok",
        "citations_min": 1,
        "non_empty_answer": true,
        "judge_required_facts": [
          "28°C",
          "15°C"
        ]
      }
    ],
    "expected": {
      "primary": {
        "entity_count": 1,
        "memory_count": 1,
        "observation_count": 1,
        "recall_audit_count": 2
      }
    }
  },
