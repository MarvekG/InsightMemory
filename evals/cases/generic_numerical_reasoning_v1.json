[
  {
    "case_id": "numerical_threshold_comparison",
    "category": "threshold_comparison",
    "description": "系统应能理解数值阈值，并在查询时正确比较大小关系。",
    "memory_scope_templates": {
      "primary": "eval:generic_numerical_reasoning_v1:{run_id}:{case_id}"
    },
    "writes": [
      {
        "context": "API Endpoint 的告警阈值：CPU 使用率超过 80% 触发黄色预警，超过 95% 触发红色预警，P99 延迟超过 500ms 触发性能告警，错误率超过 1% 触发质量告警。",
        "expected_status": "accepted"
      }
    ],
    "queries": [
      {
        "query_id": "q1",
        "query": "CPU 使用率达到多少会触发红色预警？",
        "expected_status": "ok",
        "citations_min": 1,
        "non_empty_answer": true,
        "judge_required_facts": [
          "95%"
        ]
      },
      {
        "query_id": "q2",
        "query": "API Endpoint 的红色预警阈值比黄色预警高多少个百分点？",
        "expected_status": "ok",
        "citations_min": 1,
        "non_empty_answer": true,
        "judge_required_facts": [
          "15",
          "95%",
          "80%"
        ]
      }
    ],
    "expected": {
      "primary": {
        "entity_count": 1,
        "memory_count": 1,
        "observation_count": 1,
        "recall_audit_count": 2
      }
    }
  },
  {
