[
  {
    "case_id": "implicit_hierarchy_inheritance",
    "category": "hierarchy_inheritance",
    "description": "系统应能推断层级关系中的隐含继承，不仅依赖显式陈述。",
    "memory_scope_templates": {
      "primary": "eval:generic_implicit_relation_v1:{run_id}:{case_id}"
    },
    "writes": [
      {
        "context": "Engineering Department 下属 Backend Team 和 Frontend Team。Backend Team 的负责人是 Sarah Lin。Frontend Team 的负责人是 Mike Chen。",
        "expected_status": "accepted"
      }
    ],
    "queries": [
      {
        "query_id": "q1",
        "query": "Backend Team 隶属于哪个部门？",
        "expected_status": "ok",
        "citations_min": 1,
        "non_empty_answer": true,
        "judge_required_facts": [
          "Engineering Department"
        ]
      },
      {
        "query_id": "q2",
        "query": "Engineering Department 有哪些团队负责人？",
        "expected_status": "ok",
        "citations_min": 1,
        "non_empty_answer": true,
        "judge_required_facts": [
          "Sarah Lin",
          "Mike Chen"
        ]
      }
    ],
    "expected": {
      "primary": {
        "entity_count": 3,
        "memory_count": 3,
        "observation_count": 1,
        "recall_audit_count": 2
      }
    }
  },
  {
    "case_id": "implicit_causality_chain",
    "category": "causality_chain",
    "description": "系统应能推断未明确陈述的因果链中间环节。",
    "memory_scope_templates": {
      "primary": "eval:generic_implicit_relation_v1:{run_id}:{case_id}"
    },
    "writes": [
      {
        "context": "Payment Service 依赖 Order Database。Order Database 当前存在主从同步延迟问题。该延迟导致 Payment Service 的缓存命中率下降，进而导致支付接口响应变慢。",
        "expected_status": "accepted"
      }
    ],
    "queries": [
      {
        "query_id": "q1",
        "query": "Payment Service 的支付接口响应变慢的根本原因是什么？",
        "expected_status": "ok",
        "citations_min": 1,
        "non_empty_answer": true,
        "judge_required_facts": [
          "Order Database",
          "主从同步延迟"
        ]
      },
      {
        "query_id": "q2",
        "query": "Order Database 的主从同步延迟对 Payment Service 产生了哪些影响？",
        "expected_status": "ok",
        "citations_min": 1,
        "non_empty_answer": true,
        "judge_required_facts": [
          "缓存命中率下降",
          "支付接口响应变慢"
        ]
      }
    ],
    "expected": {
      "primary": {
        "entity_count": 2,
        "memory_count": 2,
        "observation_count": 1,
        "recall_audit_count": 2
      }
    }
  },
