    "writes": [
      {
        "context": "Sable clinic review 之前卡在 intake form 缺少 triage stamp。",
        "expected_status": "accepted"
      },
      {
        "context": "Sable clinic review 当前主阻塞已经变成 lab consent 缺少 guardian signature。",
        "expected_status": "accepted"
      }
    ],
    "queries": [
      {
        "query_id": "q1",
        "query": "Sable clinic review 当前主阻塞是什么？",
        "expected_status": "ok",
