        "non_empty_answer": true,
        "judge_required_facts": [
          "lab consent",
          "guardian signature"
        ],
        "judge_forbidden_facts": [
          "triage stamp"
        ]
      },
      {
        "query_id": "q2",
        "query": "Sable clinic review 之前卡在哪里？",
        "expected_status": "ok",
        "citations_min": 1,
        "non_empty_answer": true,
        "judge_required_facts": [
          "intake form",
          "triage stamp"
        ],
        "judge_forbidden_facts": [
          "guardian signature"
        ]
      }
    ],
    "expected": {
      "primary": {
        "observation_count": 2,
        "recall_audit_count": 2,
        "required_memory_texts": [
          "guardian signature",
          "triage stamp"
        ]
      }
    }
  },
